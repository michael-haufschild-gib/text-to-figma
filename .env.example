# Text-to-Figma MCP Server — Environment Variables
# Copy to .env and adjust as needed. All values shown are defaults.

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development              # development | staging | production | test

# ── Figma Bridge ──────────────────────────────────────────────────────────────
FIGMA_WS_URL=ws://localhost:8080  # WebSocket bridge base URL; local auto-scan starts here
TEXT_TO_FIGMA_WS_PORT_SCAN_LIMIT=20  # Local bridge scan count (8080-8099 by default)
TEXT_TO_FIGMA_WS_HOST=127.0.0.1  # Bridge listen address; 0.0.0.0 only for containers or a remote bridge
FIGMA_REQUEST_TIMEOUT=30000       # Request timeout (ms)
FIGMA_MAX_RECONNECT_ATTEMPTS=5    # Max reconnect attempts before giving up

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                    # debug | info | warn | error | fatal
LOG_JSON=false                    # true for structured JSON logs

# ── Health Check ──────────────────────────────────────────────────────────────
HEALTH_CHECK_ENABLED=true         # Enable HTTP health check server
HEALTH_CHECK_PORT=8081            # Health check server port

# ── Monitoring ────────────────────────────────────────────────────────────────
ERROR_TRACKER_MAX_ERRORS=1000     # Max tracked errors before pruning
ERROR_TRACKER_AGGREGATION_WINDOW=3600000  # Error aggregation window (ms, default: 1h)
ERROR_TRACKER_PRUNE_INTERVAL=300000       # Auto-prune interval (ms, default: 5min)

# ── Circuit Breaker ───────────────────────────────────────────────────────────
CIRCUIT_BREAKER_ENABLED=true      # Enable circuit breaker for Figma bridge
CIRCUIT_BREAKER_THRESHOLD=5       # Failures before opening circuit
CIRCUIT_BREAKER_RESET_TIMEOUT=30000  # Time before half-open test (ms)

# ── Export ────────────────────────────────────────────────────────────────────
# EXPORT_OUTPUT_DIR=/path/to/project  # Root for relative export paths (default: server cwd)
EXPORT_MAX_INLINE_BYTES=1048576   # Max export returned inline as base64/SVG text (1MB)

# ── Retry ─────────────────────────────────────────────────────────────────────
RETRY_MAX_ATTEMPTS=3              # Max retry attempts for failed requests
RETRY_BASE_DELAY=1000             # Base delay between retries (ms)
RETRY_MAX_DELAY=30000             # Maximum delay between retries (ms)

# ── Server ────────────────────────────────────────────────────────────────────
GRACEFUL_SHUTDOWN_TIMEOUT=30000   # Max time for graceful shutdown (ms)
